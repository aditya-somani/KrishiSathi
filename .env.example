# LiveKit server configuration (automatically injected on LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Gnani.ai Speech AI (Vachana STT + Timbre TTS)
GNANI_API_KEY=your_gnani_api_key

# Google Gemini (primary reasoning LLM & Search grounding)
GOOGLE_API_KEY=your_google_api_key
WEB_API_KEY=your_web_search_api_key
GOOGLE_API_KEY_2=your_secondary_google_key

# Groq (optional fast post-call summarization)
GROQ_API_KEY=your_groq_api_key

