# LiveKit server configuration (injected automatically on LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Gnani.ai Vachana Speech AI (STT + TTS)
GNANI_API_KEY=your_gnani_api_key

# Groq (primary conversational LLM + call summarization)
GROQ_API_KEY=your_groq_api_key
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Optional: Google Gemini (for live Google Search grounding tool / fallback LLM)
GOOGLE_API_KEY=your_google_api_key
WEB_API_KEY=your_web_search_api_key
